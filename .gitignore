# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/
env/
.pytest_cache/

# PyInstaller build artifacts
build/
dist/
# keep the build recipe (gui/LeadEngine.spec); ignore other generated *.spec
*.spec
!gui/LeadEngine.spec

# GUI run outputs (generated lead files)
gui/_output/*
!gui/_output/.gitkeep

# Scraped / generated lead data — NEVER commit this. The whole point of keeping
# the repo a *tool* (not a dataset) is privacy + staying out of data-broker
# territory. Output is regenerated per run.
*.csv
*.xlsx
*.jsonl
*.json
*.parquet
*.sqlite
*.vcf
*.leads.md
leadgen.toml          # a user's real config may name private datasets; keep the example only
!leadgen.example.toml

# IDE / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
